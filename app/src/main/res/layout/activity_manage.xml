<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- 顶部导航与模块切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← 返回前台"
            android:textColor="#111827"
            android:backgroundTint="#FFC300"/>

        <!-- 4大管理子系统切换 -->
        <Button
            android:id="@+id/btnTabProducts"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:text="🍲 菜品管理"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E2433"/>

        <Button
            android:id="@+id/btnTabCategories"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="📑 分类管理"
            android:textColor="#111827"
            android:backgroundTint="#E5E7EB"/>

        <Button
            android:id="@+id/btnTabStaffs"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="👤 员工管理"
            android:textColor="#111827"
            android:backgroundTint="#E5E7EB"/>

        <Button
            android:id="@+id/btnTabTables"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="🪑 桌台管理"
            android:textColor="#111827"
            android:backgroundTint="#E5E7EB"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnAddNewItem"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="➕ 新增菜品"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvManageList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"/>
</LinearLayout>