<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#1E2433">

    <!-- 左侧品牌标识 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="美团收银 (青春版)"
            android:textColor="#FFC300"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="纯本地单机版 | 堂食桌台与快餐管理"
            android:textColor="#9CA3AF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="初始账号密码：\n店长 PIN: 888888\n收银员 PIN: 1234\n(支持屏幕触控与物理键盘输入)"
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"/>
    </LinearLayout>

    <!-- 右侧实体按键键盘 (纯白卡片) -->
    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请输入员工登录 PIN 码"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinDisplay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#F3F4F6"
            android:gravity="center"
            android:hint="请输入PIN码"
            android:textColorHint="#9CA3AF"
            android:textColor="#111827"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <!-- 3x4 实体按键网格 -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3">

            <TextView android:id="@+id/btn1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btn4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btn7" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn8" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn9" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnClear" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:background="#FEE2E2" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn0" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="26sp" android:textStyle="bold" android:background="#F3F4F6" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="64dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:background="#E5E7EB" android:clickable="true" android:focusable="true"/>
        </GridLayout>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="进入系统"
            android:textStyle="bold"
            android:textSize="20sp"
            android:backgroundTint="#FFC300"
            android:textColor="#111827"/>
    </LinearLayout>
</LinearLayout>
