<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:id="@+id/layoutCardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#E6F9F0">

        <!-- 顶部：桌号与状态徽标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTableName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A01"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tvTableCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="(4人)"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:singleLine="true"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="🟢 空闲"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:background="#FFFFFF"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- 中部：消费金额或预定信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTableInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="桌位就绪，可点单"
                android:textSize="12sp"
                android:textColor="#4B5563"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvTableAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="￥0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#D97706"
                android:singleLine="true"
                android:visibility="gone"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginVertical="4dp"/>

        <!-- 底部：直接 3 按键直达 (开台、预定、预定点菜)，防换行排版 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCardAction1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="开台"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnCardAction2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="预定"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnCardAction3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="预定点菜"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B5CF6"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>