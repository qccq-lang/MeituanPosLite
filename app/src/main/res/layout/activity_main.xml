<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 顶部黄色导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFC300"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="六猫餐饮"
            android:textStyle="bold"
            android:textColor="#111827"
            android:textSize="20sp"/>

        <Button
            android:id="@+id/btnNavTables"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="24dp"
            android:text="🪑 堂食桌台"
            android:textStyle="bold"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btnNavFastFood"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="⚡ 快餐收银"
            android:textStyle="bold"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvCashierInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="员工: 店长"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnManage"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="⚙ 后台管理"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E2433"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btnReport"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="📊 营业报表"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E2433"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="交班退出"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <!-- 视图1：堂食桌台全景大厅 -->
    <LinearLayout
        android:id="@+id/layoutTableOverview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="桌台状态："
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🟢 空闲 (可点单/预定)  "
                android:textColor="#059669"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🟠 就餐中 (挂单中/加菜/结账)  "
                android:textColor="#D97706"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🔵 已预定 (支持提前预点菜)  "
                android:textColor="#2563EB"
                android:textSize="14sp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTableGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- 视图2：点菜/搜索/折扣/结账界面 -->
    <LinearLayout
        android:id="@+id/layoutOrderScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 左侧购物车与结算 (38% 宽度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.8"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F3F4F6"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">
                <Button
                    android:id="@+id/btnBackToTables"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="← 返回桌台"
                    android:textSize="12sp"
                    android:textColor="#111827"
                    android:backgroundTint="#E5E7EB"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
                <TextView
                    android:id="@+id/tvOrderTableTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="当前桌台: A01"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="15sp"/>
                <Button
                    android:id="@+id/btnWholeDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="🏷 整单折扣"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#8B5CF6"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- 底部金额明细与独立抹零 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FAFAFA">

                <!-- 独立自动抹零复选框 (不与任何折扣冲突) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">
                    <CheckBox
                        android:id="@+id/cbAutoMoling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动抹零 (去除角分零头)"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:textStyle="bold"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/tvDiscountInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#8B5CF6"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="共 0 件"
                        android:textSize="14sp"
                        android:textColor="#6B7280"/>
                    <TextView
                        android:id="@+id/tvOriginalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="￥0.00"
                        android:textSize="14sp"
                        android:textColor="#9CA3AF"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="￥0.00"
                        android:textColor="#EF4444"
                        android:textSize="26sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/btnClearCart"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="清空"
                        android:backgroundTint="#E5E7EB"
                        android:textColor="#111827"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                    <Button
                        android:id="@+id/btnSaveTableOrder"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:layout_marginStart="6dp"
                        android:text="下单挂单"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:backgroundTint="#F59E0B"
                        android:textColor="#FFFFFF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                    <Button
                        android:id="@+id/btnPay"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:layout_marginStart="6dp"
                        android:text="结账收款"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:backgroundTint="#FFC300"
                        android:textColor="#111827"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧菜品分类、拼音搜索与菜品矩阵 (62% 宽度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6.2"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- 搜索框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="16sp"/>

                <EditText
                    android:id="@+id/etSearchDish"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="输入菜名或拼音首字母 (例如: hmj 搜黄焖鸡)"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="#9CA3AF"
                    android:padding="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>