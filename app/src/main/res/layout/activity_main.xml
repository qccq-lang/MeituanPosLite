<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 顶部全屏黄色导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFD100"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="美团收银 (青春版)"
            android:textStyle="bold"
            android:textColor="#222222"
            android:textSize="20sp"/>

        <!-- 模式切换选项卡 (堂食桌台大厅 vs 快餐外卖) -->
        <Button
            android:id="@+id/btnNavTables"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:text="🪑 堂食桌台"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C344B"/>

        <Button
            android:id="@+id/btnNavFastFood"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="⚡ 快餐收银"
            android:textColor="#222222"
            android:backgroundTint="#FFFFFF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvCashierInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="员工: 店长"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnManage"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="⚙ 后台管理"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C344B"/>

        <Button
            android:id="@+id/btnReport"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="📊 营业报表"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C344B"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="交班退出"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF3B30"/>
    </LinearLayout>

    <!-- 视图1：堂食桌台全景大厅 (默认展示) -->
    <LinearLayout
        android:id="@+id/layoutTableOverview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <!-- 状态图例说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="桌台状态："
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🟢 空闲 (可开台点单)  "
                android:textColor="#2E7D32"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🟠 就餐中 (已挂单/可加菜/结账)  "
                android:textColor="#E65100"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🔵 已预定  "
                android:textColor="#1565C0"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="💡 提示：点击桌台开台/加菜/结账，长按可预定"
                android:textColor="#757575"
                android:textSize="13sp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTableGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- 视图2：点菜/加菜/结账界面 -->
    <LinearLayout
        android:id="@+id/layoutOrderScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 左侧已选菜品与挂单结算栏 (38% 宽度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.8"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <!-- 顶部当前桌号与返回 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F4F5F7"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">
                <Button
                    android:id="@+id/btnBackToTables"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="← 返回桌台"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:backgroundTint="#E0E0E0"/>
                <TextView
                    android:id="@+id/tvOrderTableTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="当前桌台: A01 (未开台)"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:textSize="15sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- 底部挂单与结账按钮组 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FAFAFA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="共 0 件"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="￥0.00"
                        android:textColor="#FF3B30"
                        android:textSize="26sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <Button
                        android:id="@+id/btnClearCart"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="清空"
                        android:backgroundTint="#EAECEF"
                        android:textColor="#333333"/>
                    <!-- 堂食专属核心：挂单开台/加菜入单 -->
                    <Button
                        android:id="@+id/btnSaveTableOrder"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:layout_marginStart="6dp"
                        android:text="下单开台/加菜"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:backgroundTint="#FF9800"
                        android:textColor="#FFFFFF"/>
                    <!-- 直接结账 -->
                    <Button
                        android:id="@+id/btnPay"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:layout_marginStart="6dp"
                        android:text="结账清台"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:backgroundTint="#FFD100"
                        android:textColor="#222222"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧菜品分类与选择矩阵 (62% 宽度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6.2"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
