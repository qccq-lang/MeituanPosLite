<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- 顶部导航与时间切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← 返回前台"
            android:textColor="#111827"
            android:backgroundTint="#FFC300"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="📊 门店营业报表与收银对账"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnFilterToday"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="今日"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E2433"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnFilterMonth"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="本月"
            android:textColor="#111827"
            android:backgroundTint="#E5E7EB"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnFilterYear"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="本年"
            android:textColor="#111827"
            android:backgroundTint="#E5E7EB"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 左侧：多维统计分析卡片 (38% 宽度) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.8"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvReportPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="统计周期: 今日"
                    android:textSize="14sp"
                    android:textColor="#6B7280"/>

                <TextView
                    android:id="@+id/tvTotalSales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="￥0.00"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#EF4444"/>

                <TextView
                    android:id="@+id/tvOriginalAndDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原价: ￥0.00 | 优惠让利: ￥0.00"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="10dp"/>

                <TextView
                    android:id="@+id/tvOrderCountAndAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="有效单量: 0 笔 | 客单价: ￥0.00"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="10dp"/>

                <!-- 收银账号对账汇总 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 各收银员业绩对账："
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvCashierDistribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="暂无数据"
                    android:lineSpacingExtra="4dp"
                    android:textSize="13sp"
                    android:textColor="#059669"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪑 场景与支付渠道分布："
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvTypeDistribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="堂食桌台: 0 笔\n快餐外带: 0 笔"
                    android:lineSpacingExtra="4dp"
                    android:textSize="13sp"
                    android:textColor="#4B5563"/>

                <TextView
                    android:id="@+id/tvPayDistribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="支付方式明细..."
                    android:lineSpacingExtra="4dp"
                    android:textSize="13sp"
                    android:textColor="#4B5563"/>
            </LinearLayout>
        </ScrollView>

        <!-- 右侧：流水订单明细列表 (62% 宽度) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6.2"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="销售订单流水 (显式标明收款账号，点击可补打小票)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>